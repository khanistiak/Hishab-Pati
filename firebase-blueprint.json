{
  "entities": {
    "Account": {
      "title": "Account",
      "description": "Financial account such as Credit Card, Debit Card, Cash, or MFS",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Owner Google UID" },
        "name": { "type": "string", "description": "Account display name" },
        "type": { "type": "string", "enum": ["BANK", "CREDIT_CARD", "DEBIT_CARD", "CASH", "MFS", "OTHER"] },
        "institution": { "type": "string" },
        "balance": { "type": "number" },
        "openingBalance": { "type": "number" },
        "accountNumberLast4": { "type": "string" },
        "colorHex": { "type": "string" },
        "iconName": { "type": "string" },
        "isHidden": { "type": "boolean" },
        "includeInTotal": { "type": "boolean" },
        "sortOrder": { "type": "integer" },
        "creditLimit": { "type": "number" },
        "billingDate": { "type": "string" },
        "paymentDueDate": { "type": "string" },
        "minPayment": { "type": "number" },
        "notes": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "name", "type", "balance", "createdAt", "updatedAt"]
    },
    "Transaction": {
      "title": "Transaction",
      "description": "Financial transaction record (Income, Expense, Transfer)",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Owner Google UID" },
        "type": { "type": "string", "enum": ["EXPENSE", "INCOME", "TRANSFER", "LEND", "BORROW", "CC_PAYMENT"] },
        "amount": { "type": "number" },
        "title": { "type": "string" },
        "category": { "type": "string" },
        "subcategory": { "type": "string" },
        "accountId": { "type": "string" },
        "toAccountId": { "type": "string" },
        "timestamp": { "type": "integer" },
        "notes": { "type": "string" },
        "isRecurring": { "type": "boolean" },
        "payeeOrPayer": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "type", "amount", "title", "accountId", "createdAt", "updatedAt"]
    },
    "CloudBackupManifest": {
      "title": "CloudBackupManifest",
      "description": "Latest full wallet backup manifest (inline GZIP+Base64 or chunked manifest pointing to latest_chunk_* sibling docs)",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Owner Google UID" },
        "docType": { "type": "string", "enum": ["manifest"] },
        "schemaVersion": { "type": "integer" },
        "payloadEncoding": { "type": "string", "enum": ["gzip_base64", "gzip_base64_chunked"] },
        "backupJsonCompressed": { "type": "string", "description": "GZIP+Base64 encoded full JSON backup when inline" },
        "revisionId": { "type": "string", "description": "Revision token matching sibling chunks when chunked" },
        "chunkCount": { "type": "integer" },
        "backupDate": { "type": "string" },
        "accountsCount": { "type": "integer" },
        "transactionsCount": { "type": "integer" },
        "categoriesCount": { "type": "integer" },
        "subcategoriesCount": { "type": "integer" },
        "budgetsCount": { "type": "integer" },
        "debtsCount": { "type": "integer" },
        "savingsGoalsCount": { "type": "integer" },
        "fileSizeBytes": { "type": "integer" },
        "compressedSizeBytes": { "type": "integer" },
        "uploadedAt": { "type": "string", "format": "date-time" },
        "uploadedAtMillis": { "type": "integer" }
      },
      "required": ["userId", "accountsCount", "transactionsCount", "categoriesCount", "debtsCount", "fileSizeBytes", "uploadedAt", "uploadedAtMillis"]
    },
    "CloudBackupChunk": {
      "title": "CloudBackupChunk",
      "description": "Sibling payload chunk (latest_chunk_0, latest_chunk_1, ...) for large multi-month backups",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Owner Google UID" },
        "docType": { "type": "string", "enum": ["chunk"] },
        "revisionId": { "type": "string" },
        "chunkIndex": { "type": "integer" },
        "totalChunks": { "type": "integer" },
        "data": { "type": "string" },
        "uploadedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "docType", "revisionId", "chunkIndex", "totalChunks", "data", "uploadedAt"]
    }
  },
  "firestore": {
    "/users/{userId}/accounts/{accountId}": {
      "schema": { "$ref": "#/entities/Account" },
      "description": "User accounts collection"
    },
    "/users/{userId}/transactions/{transactionId}": {
      "schema": { "$ref": "#/entities/Transaction" },
      "description": "User transactions collection"
    },
    "/users/{userId}/backups/{backupId}": {
      "schema": { "$ref": "#/entities/CloudBackupManifest" },
      "description": "User cloud backup manifest ('latest') and sibling chunks ('latest_chunk_*')"
    }
  }
}
